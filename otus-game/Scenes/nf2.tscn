[sub_resource type="GDScript" id="GDScript_jviro"]
script/source = "extends NinePatchRect

var hovered = false
var selected = false
var disabled = false

func _ready():
	pass
	
func _process(delta):
	disabled = get_tree().get_node_count_in_group(\"voidlings\") <= 0
	
	modulate = Color(\"777\") if disabled else Color(\"FFF\")
	$Button.visible = !disabled
	
	self_modulate = lerp(self_modulate, Color.WHITE if selected else Color(0.39, 0.39, 0.39), 0.1)
	$ColorRect.color = Color(\"D16F00\").lightened(0.05) if hovered else Color(\"D16F00\")

func _on_button_mouse_entered():
	hovered = true
	
func _on_button_mouse_exited():
	hovered = false

func _on_button_pressed():
	selected = true
	get_node(\"../destroy\").selected = false
	
	get_node(\"../../../../automation/culture\").start()
	get_node(\"../../../../automation/destroy\").stop()
	
	get_node(\"../../../../sandbox\").update_destination_bar()
"

[sub_resource type="LabelSettings" id="LabelSettings_jviro"]
outline_size = 8
outline_color = Color(0, 0, 0, 1)

[sub_resource type="GDScript" id="GDScript_cl2em"]
script/source = "extends NinePatchRect

var hovered = false
var selected = false
var disabled = false

func _ready():
	pass
	
func _process(delta):
	disabled = get_tree().get_node_count_in_group(\"voidlings\") < 2 or !get_node(\"../../../../automation\").thats_enough
	
	if disabled:
		selected = false
	
	modulate = Color(\"777\") if disabled else Color(\"FFF\")
	$Button.visible = !disabled
	
	self_modulate = lerp(self_modulate, Color.WHITE if selected else Color(0.39, 0.39, 0.39), 0.1)
	$ColorRect.color = Color(\"D16F00\").lightened(0.05) if hovered else Color(\"D16F00\")

func _on_button_mouse_entered():
	hovered = true
	
func _on_button_mouse_exited():
	hovered = false

func _on_button_pressed():
	selected = true
	get_node(\"../culture\").selected = false
	
	get_node(\"../../../../automation/destroy\").start()
	get_node(\"../../../../automation/culture\").stop()
	
	get_node(\"../../../../sandbox\").update_destination_bar()
"

[sub_resource type="GDScript" id="GDScript_2wapo"]
script/source = "extends Control

var hovered = false

func _ready():
	pass
	
func _process(delta):
	$ColorRect.self_modulate.a = lerp($ColorRect.self_modulate.a, 0.1 if hovered else 0.0, 0.2)

func _on_button_mouse_entered():
	hovered = true

func _on_button_mouse_exited():
	hovered = false

func _on_button_pressed():
	get_parent().sell_results()
"

