[sub_resource type="GDScript" id="GDScript_15ig2"]
script/source = "extends NinePatchRect

var enabled = false
var hovering = false
var pressed = false

func _ready():
	pass
	
func _process(delta):
	modulate.a = lerp(modulate.a, 1.0 if enabled else 0.13, 0.2)
	
	$ColorRect.modulate.a = lerp($ColorRect.modulate.a, (0.2 if pressed else 0.9) if hovering else 1.0, 0.2)

func _on_button_mouse_entered():
	hovering = true

func _on_button_mouse_exited():
	hovering = false

func _on_button_button_down():
	if enabled:
		pressed = true

func _on_button_button_up():
	pressed = false

func _on_button_pressed():
	if enabled:
		get_parent().get_parent().get_parent().add_cpus()
"

