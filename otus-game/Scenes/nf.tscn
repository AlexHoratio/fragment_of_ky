[sub_resource type="GDScript" id="GDScript_2wapo"]
script/source = "extends Control

var hovered = false

func _ready():
	pass
	
func _process(delta):
	$ColorRect.self_modulate.a = lerp($ColorRect.self_modulate.a, 0.1 if hovered else 0.0, 0.2)

func _on_button_mouse_entered():
	hovered = true

func _on_button_mouse_exited():
	hovered = false

func _on_button_pressed():
	get_parent().sell_results()
"

