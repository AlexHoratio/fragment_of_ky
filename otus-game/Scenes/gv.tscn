[sub_resource type="GDScript" id="GDScript_46ma7"]
script/source = "extends Area2D

var flipped_once = false

func _ready():
	pass
	
func _process(delta):
	if randi()%480 == 0 and !flipped_once:
		flipped_once = true
		$AnimatedSprite2D.flip_h = !$AnimatedSprite2D.flip_h

func damage(val) -> void:
	get_node(\"../genome\").open()
	
	get_node(\"../orteil\").walk_to(Vector2(960, 550))
	get_node(\"../orteil\").queue_dialogue_after_walk(\"On Earth, every living thing has its own [color=#aaa][wave]genome[/wave][color=#fff].\", true, 0.5, 2, \"gv_has_genome\", 8)
	
	queue_free()

func _on_shoot_timeout():
	var iron_bullet = load(\"res://Prefabs/Bullets/iron_bullet.tscn\").instantiate()
	iron_bullet.movement_vector = Vector2(-1, 1)
	iron_bullet.position = position + Vector2(1000, -1000)
	get_parent().add_child(iron_bullet)
"

