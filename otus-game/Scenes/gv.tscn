[sub_resource type="GDScript" id="GDScript_ktmpt"]
script/source = "extends Control

func _ready():
	get_tree().set_meta(\"tooltip\", self)
	set_text(\"\")
	
func _process(delta):
	global_position = get_global_mouse_position()

func set_text(text = \"\") -> void:
	size.x = $Label.get_theme_font(\"font\").get_string_size(text).x + 32
	$Label.text = text
	
	visible = text != \"\"
"

[sub_resource type="GDScript" id="GDScript_2ayy1"]
script/source = "extends VBoxContainer

func _ready():
	pass
	
func _process(delta):
	pass
	#position.y = lerp(position.y, 521.0 if open else 1150.0, 0.1)

func open() -> void:
	var tween = get_tree().create_tween()
	tween.tween_property(self, \"position:y\", 650.0, 0.5).set_trans(Tween.TRANS_CIRC)
	
"

[sub_resource type="GDScript" id="GDScript_jogvw"]
script/source = "extends ColorRect

var hovering = false

func _ready():
	pass
	
func _process(delta):
	$ColorRect.self_modulate.a = lerp($ColorRect.self_modulate.a, 1.0 if hovering else 0.0, 0.2)

func _on_button_mouse_entered():
	hovering = true
	get_tree().get_meta(\"tooltip\").set_text(\"Marker Gene\")

func _on_button_mouse_exited():
	hovering = false
	get_tree().get_meta(\"tooltip\").set_text(\"\")
"

