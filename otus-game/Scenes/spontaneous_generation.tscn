[sub_resource type="GDScript" id="GDScript_5osj0"]
script/source = "extends Control

func _ready():
	pass
	
func _process(delta):
	$Label.text = str(int(round(Gold.gold))) + \"g\"
	
	modulate.a = lerp(modulate.a, 1.0 if Gold.gold > 0 else 0.0, 0.05)
		
"

